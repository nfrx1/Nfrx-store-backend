{
  "name": "nfrx-store-backend",
  "version": "1.0.0",
  "description": "Backend API for NFRX Store using Express, Prisma, and PostgreSQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev --name init && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@prisma/config": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
